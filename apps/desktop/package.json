{
  "name": "@knosys-rag/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Knosys RAG desktop application",
  "author": "Knosys",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package": "pnpm build && electron-builder --mac",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@knosys-rag/contracts": "workspace:*",
    "@knosys-rag/core": "workspace:*",
    "@knosys-rag/engine": "workspace:*",
    "@knosys-rag/ingestion": "workspace:*",
    "@knosys-rag/storage-sqlite": "workspace:*",
    "@napi-rs/canvas": "1.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.555.0",
    "motion": "^13.1.1",
    "pdfjs-dist": "6.2.108",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "io.knosys.rag",
    "productName": "Knosys RAG",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sqlite-vec-darwin-arm64/vec0.dylib"
    ],
    "mac": {
      "category": "public.app-category.reference",
      "hardenedRuntime": true,
      "minimumSystemVersion": "15.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
